# Browser (public) — from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Set to true after enabling Google in Supabase → Authentication → Providers
VITE_ENABLE_GOOGLE=false

# Server only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Games: IGDB (Twitch developer app) is used when both are set, otherwise RAWG
IGDB_CLIENT_ID=xxxxxxxx
IGDB_CLIENT_SECRET=xxxxxxxx
RAWG_API_KEY=xxxxxxxx
TMDB_TOKEN=eyJ...
